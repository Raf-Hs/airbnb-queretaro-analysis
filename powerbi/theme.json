{
  "name": "Queretaro Editorial",
  "dataColors": [
    "#1F3B57",
    "#2A9D8F",
    "#E9C46A",
    "#F4A261",
    "#E76F51",
    "#8D99AE",
    "#4F6D7A",
    "#A8DADC"
  ],
  "background": "#FFFFFF",
  "foreground": "#2B2D42",
  "tableAccent": "#1F3B57",
  "good": "#2A9D8F",
  "neutral": "#E9C46A",
  "bad": "#E76F51",
  "maximum": "#1F3B57",
  "center": "#E9C46A",
  "minimum": "#F4F1EC",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 16,
      "color": "#1F3B57"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#2B2D42"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#4A4E69"
    },
    "callout": {
      "fontFace": "Segoe UI Light",
      "fontSize": 34,
      "color": "#1F3B57"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6E2DC" } },
            "radius": 2
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": { "solid": { "color": "#FFFFFF" } },
            "foreground": { "solid": { "color": "#4A4E69" } }
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F3B57" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F7F5F2" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#F7F5F2" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 26,
            "fontFamily": "Segoe UI Light",
            "color": { "solid": { "color": "#1F3B57" } }
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "color": { "solid": { "color": "#6B7280" } }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": { "solid": { "color": "#2B2D42" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    }
  }
}
